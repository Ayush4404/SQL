consecutive available seats
SELECT seat_id
FROM(SELECT*,LEAD(free)OVER(ORDER BY seat_id) AS NextSeat 
FROM Cinema) AS W
WHERE W.free=1 AND W.NextSeat=1
ORDER BY W.seat_id
